flowchart TB

TIN@{ shape: doc, label: "<b>proto_train.csv</b> (712)<br/>+ refined SDF · PDB" }
TCONV["<b>convert_seminar_to_karmadock.py</b><br/>seminar → KarmaDock layout"]
TPOCK["<b>pre_processing.py</b><br/>extract 12 Å pocket (prody)"]
TGRAPH["<b>generate_graph.py</b><br/>.dgl graph per complex"]
DT{"If --init_model<br/>is set?"}
TMODE2["P2: from scratch<br/>2-stage (scoring → docking)"]
TMODE3["P3: fine-tune<br/>1-stage from released"]
TRAIN["<b>train.py</b> — one epoch<br/>MDN + RMSD loss · grad-accum (eff. batch 64)"]
DE{"Early_stopper:<br/>val loss<br/>improved?"}
CKPT@{ shape: doc, label: "<b>trained weights</b><br/>p2 / p3 .pkl  (→ used in inference as P2 / P3)" }

TIN -->|complex| TCONV --> TPOCK --> TGRAPH -->|graphs| DT
DT -->|"no → P2"| TMODE2
DT -->|"yes → P3"| TMODE3
TMODE2 --> TRAIN
TMODE3 --> TRAIN
TRAIN --> DE
DE -->|"yes: save best,<br/>next epoch"| TRAIN
DE -->|"no: patience<br/>exceeded"| CKPT

